[Unit]
Description=CSI camera %i to v4l2loopback bridge (GStreamer)
After=nvargus-daemon.service
Requires=nvargus-daemon.service
Before=photonvision.service
StartLimitIntervalSec=0

[Service]
Type=simple
# %i = sensor id (0, 1, ...). Output device is /dev/video1<sensor id>,
# i.e. instance 0 -> /dev/video10, instance 1 -> /dev/video11.
# Matches runbook.md step 4's v4l2loopback video_nr=10,11 layout.
ExecStart=/opt/subzero/picam-to-v4l2.sh %i /dev/video1%i
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
