[Unit]
Description=PhotonVision vision processing service (v2026.3.4)
After=network-online.target nvargus-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/photonvision
ExecStart=/usr/bin/java -Xmx512m -jar /opt/photonvision/photonvision.jar
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
